{
  "manifest_version": 3,
  "name": "__MSG_app_name__",
  "version": "9.0.0",
  "description": "__MSG_app_description__",
  "default_locale": "en",
  "minimum_chrome_version": "111",
  "homepage_url": "https://github.com/ehsanenaloo/AI-Bulk-Chat-Manager",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "src/popup/popup.html",
    "default_title": "__MSG_action_title__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*"
      ],
      "js": [
        "src/shared/namespace.js",
        "src/shared/ext.js",
        "src/shared/sites.js",
        "src/shared/links.js",
        "src/shared/settings.js",
        "src/shared/i18n.js",
        "src/shared/icons.js",
        "src/content/config.js",
        "src/content/util.js",
        "src/content/dom.js",
        "src/content/state.js",
        "src/content/checkboxes.js",
        "src/content/engines/api.js",
        "src/content/engines/visual.js",
        "src/content/bulk.js",
        "src/content/auto-attach.js",
        "src/content/loader.js",
        "src/content/exporter.js",
        "src/content/ui/panel.js",
        "src/content/app.js",
        "src/content/bridge.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "__MSG_command_toggle_panel__"
    }
  }
}
